{
  "name": "wordpress-blogs",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "docker:up": "docker compose up -d --scale wordpress=2",
    "docker:down": "docker compose down",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,scss,md,html,json,yml,yaml,svg}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,scss,md,html,json,yml,yaml,svg}\"",
    "php:fix": "vendor/bin/phpcbf -p -n --standard=PSR12 wordpress/wp-content/themes wordpress/wp-content/plugins",
    "php:lint": "vendor/bin/phpcs -p -n --standard=PSR12 wordpress/wp-content/themes wordpress/wp-content/plugins"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
